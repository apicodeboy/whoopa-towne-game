{
  "name": "@whoopa/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx test/run.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.27",
    "@colyseus/schema": "^5.0.45",
    "@colyseus/ws-transport": "^0.18.4",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.9",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6"
  }
}
